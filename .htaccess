DirectoryIndex index.php
Options -Indexes
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
</IfModule>
RewriteEngine On
# Les identifiants ne transitent qu'en HTTPS (l'aperçu local reste accessible).
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]
# L'ancien index.html reste utilisable, mais passe par le contrôle de session.
RewriteRule ^(?:index\.html)?$ index.php [L]
RewriteRule ^projets/(tempo|en-route)/(?:index\.html)?$ projets/$1/index.php [L]
<FilesMatch "(?:^.*-config\.php$|^config\.php$|\.(?:sql|sqlite|db|lock)$)">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>
